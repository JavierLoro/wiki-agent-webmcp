# Server-only secret. Never expose it through a VITE_ variable or Docker build argument.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Required access credentials. Use a long password and generate the secret with:
# openssl rand -hex 32
APP_PASSWORD=replace-with-a-long-password
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Internal HTTP port. Keep 3001 unless the Compose mapping is changed too.
PORT=3001

# Host-side port published by Docker Compose.
HOST_PORT=3001

# Compose overrides this to /data/wiki-agent.db inside the container.
DATABASE_PATH=/data/wiki-agent.db
